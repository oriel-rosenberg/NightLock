<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      QUERY_ALL_PACKAGES: since Android 11 an app only sees a filtered list of other apps.
      NightLock needs the full list to show every app in the pickers, and to find the phone,
      clock, launcher and Settings packages so it can make sure they are never blocked.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
      POST_NOTIFICATIONS (Android 13+): shows the wind-down warning before a schedule starts.
      You're asked once; saying no only turns the warning off.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- NightLock never touches the network. This strips INTERNET even if a library asks for it. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- supportsRtl is off: the app is in English, so it stays left to right on a Hebrew phone too. -->
    <application
        android:name=".NightLockApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.NightLock">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The block screen runs in its own task (taskAffinity) and stays out of Recents, so it
          can't be used to get back into the blocked app. noHistory finishes it once it's hidden.
        -->
        <activity
            android:name=".block.BlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="com.orirose.nightlock.block" />

        <!--
          The accessibility service is how NightLock sees which app is on screen.
          BIND_ACCESSIBILITY_SERVICE means only the system can connect to it.
        -->
        <service
            android:name=".block.BlockerService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
